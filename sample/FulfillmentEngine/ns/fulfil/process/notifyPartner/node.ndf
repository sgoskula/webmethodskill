<?xml version="1.0" encoding="UTF-8"?>
<Values>
  <value name="node_type">service</value>
  <value name="svc_type">flow</value>
  <value name="node_comment">Sends a ship notice to the trading partner through Trading Networks. Service names are illustrative.</value>
  <record name="svc_sig">
    <record name="sig_in"><array name="rec_fields">
      <record><value name="field_name">orderId</value><value name="field_type">string</value><value name="field_dim">0</value></record>
      <record><value name="field_name">partnerId</value><value name="field_type">string</value><value name="field_dim">0</value></record>
      <record><value name="field_name">shipNoticeXml</value><value name="field_type">object</value><value name="field_dim">0</value></record>
    </array></record>
    <record name="sig_out"><array name="rec_fields">
      <record><value name="field_name">delivered</value><value name="field_type">string</value><value name="field_dim">0</value></record>
    </array></record>
  </record>
</Values>
