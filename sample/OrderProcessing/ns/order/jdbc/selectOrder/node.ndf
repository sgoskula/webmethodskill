  <value name="tableName">ORDERS</value>
  <value name="sqlStatement">SELECT ORDER_ID, CUSTOMER_ID, AMOUNT, STATUS FROM ORDERS WHERE ORDER_ID = ?</value>
  <record name="svc_sig">
