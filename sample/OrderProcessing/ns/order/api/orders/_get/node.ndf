<?xml version="1.0" encoding="UTF-8"?>
<Values>
  <value name="node_type">service</value>
  <value name="svc_type">flow</value>
  <value name="node_comment">REST resource: returns the status of one order, identified by the orderId query parameter.</value>
  <record name="svc_sig">
    <record name="sig_in">
      <array name="rec_fields">
        <record>
          <value name="field_name">orderId</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="field_opt">true</value>
          <value name="node_comment">Query parameter.</value>
        </record>
      </array>
    </record>
    <record name="sig_out">
      <array name="rec_fields">
        <record>
          <value name="field_name">order</value>
          <value name="field_type">record</value>
          <value name="field_dim">0</value>
          <value name="field_opt">true</value>
          <array name="rec_fields">
            <record>
              <value name="field_name">orderId</value>
              <value name="field_type">string</value>
              <value name="field_dim">0</value>
            </record>
            <record>
              <value name="field_name">status</value>
              <value name="field_type">string</value>
              <value name="field_dim">0</value>
            </record>
            <record>
              <value name="field_name">amount</value>
              <value name="field_type">string</value>
              <value name="field_dim">0</value>
            </record>
          </array>
        </record>
        <record>
          <value name="field_name">error</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="field_opt">true</value>
        </record>
      </array>
    </record>
  </record>
</Values>
