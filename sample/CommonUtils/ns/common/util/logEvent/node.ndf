<?xml version="1.0" encoding="UTF-8"?>
<Values>
  <value name="node_type">service</value>
  <value name="svc_type">flow</value>
  <value name="node_comment">Writes one audit line to the server log for an order event.</value>
  <record name="svc_sig">
    <record name="sig_in">
      <array name="rec_fields">
        <record>
          <value name="field_name">eventType</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
        </record>
        <record>
          <value name="field_name">orderId</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
        </record>
        <record>
          <value name="field_name">message</value>
          <value name="field_type">string</value>
          <value name="field_dim">0</value>
          <value name="field_opt">true</value>
        </record>
      </array>
    </record>
    <record name="sig_out">
      <array name="rec_fields">
      </array>
    </record>
  </record>
</Values>
